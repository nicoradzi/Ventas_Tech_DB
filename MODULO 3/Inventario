-- SECCION DDL -- 
-- SE LA CREA CON EL OBJETIVO DE QUE CADA VEZ QUE SE CARGA UN DATO
-- O SE HACE UNA QUERY, SE REINICIE TODO EL PROCESO SIEMPRE
    
DROP TABLE IF EXISTS inventario;
-- _________________________________________________
-- SECCION DML --
-- CREACION DE TABLA PRINCIPAL DE INVENTARIOS
-- _________________________________________________
CREATE TABLE inventario (
    id_producto INT PRIMARY KEY,
    nombre_producto VARCHAR(100),
    categoria VARCHAR(50),
    precio_unitario DECIMAL(10,2),
    stock_actual INT,
    stock_minimo INT,
    fecha_ingreso DATE,
    activo BIT 
);
